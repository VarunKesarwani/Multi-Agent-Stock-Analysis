# Copy to .env. Never commit real API keys.
# Supported providers: ollama (default), openai, gemini, sarvam
NEWS_LLM_PROVIDER=ollama

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=120

# Only the selected cloud provider needs a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=120

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=120

SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_TIMEOUT_SECONDS=120

NEWS_LLM_MAX_ATTEMPTS=3
NEWS_LLM_RETRY_DELAY_SECONDS=5
NEWS_MAX_INPUT_CHARS=12000
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
