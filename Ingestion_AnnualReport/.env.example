# Copy to .env. Relative paths resolve beside this file, not the notebook cwd.
# Windows example: EDUCATIONAL_PDF_DIR=C:/Repo/RAG_Fin_Learning/Education
ANNUAL_PDF_DIR=../RAG_Fin_Learning/AnnualReport
EDUCATIONAL_PDF_DIR=../RAG_Fin_Learning/Education
MARKDOWN_DIR=../RAG_Fin_Learning/Processed_Markdown
SYMBOLS_CSV=../symbols.csv
PDF_SUMMARY_CSV=processing_summary.csv
EDUCATIONAL_SOURCE=unspecified
EDUCATIONAL_TOPIC=financial_education

# ollama (local, default) or openai. Both document types use this same model.
EMBEDDING_TYPE=ollama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_URL=http://localhost:11434
# For EMBEDDING_TYPE=openai set EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
EMBED_BATCH_SIZE=8
EMBED_MAX_ATTEMPTS=3
CONNECT_TIMEOUT_SECONDS=5
EMBED_TIMEOUT_SECONDS=120
RETRY_BASE_SECONDS=2

# Sizes are characters, not tokens. Overlap must be smaller than chunk size.
CHUNK_SIZE_CHARS=4000
CHUNK_OVERLAP_CHARS=400

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=annual_reports
QDRANT_TIMEOUT_SECONDS=30
QDRANT_LOOKUP_BATCH_SIZE=256
SKIP_EXISTING=true
# Leave false for new collections. For your existing collection, enable ONLY
# after confirming its unlabelled vectors used this exact provider and model.
ALLOW_LEGACY_EMBEDDINGS=false
FAILURE_LOG=annual_report_embedding_failures.jsonl


# Answer generation is independent of EMBEDDING_TYPE/MODEL.
# Changing embedding model requires re-ingestion into a new collection.
RAG_CONFIG_FILE=config.yaml
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024
RAG_TOP_K=5
RAG_CONTEXT_CHARS=16000
LOG_FILE=logs/app.log
