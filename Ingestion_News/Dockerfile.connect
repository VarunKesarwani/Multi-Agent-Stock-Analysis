FROM alpine:3.21 AS plugin

RUN apk add --no-cache curl unzip \
    && curl --fail --location --show-error --silent \
       https://hub-downloads.confluent.io/api/plugins/confluentinc/kafka-connect-elasticsearch/versions/15.1.3/confluentinc-kafka-connect-elasticsearch-15.1.3.zip \
       --output /tmp/elasticsearch-sink.zip \
    && mkdir -p /plugins \
    && unzip -q /tmp/elasticsearch-sink.zip -d /plugins

FROM confluentinc/cp-kafka-connect:8.3.2

COPY --from=plugin /plugins/ /usr/share/confluent-hub-components/
