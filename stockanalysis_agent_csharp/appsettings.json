{
  "AllowedHosts": "localhost;127.0.0.1",
  "McpClientManager": {
    "InitializationTimeoutSeconds": 30,
    "ToolCallTimeoutSeconds": 60,
    "ReconnectIntervalSeconds": 30,
    "MaxParallelConnections": 4,
    "Servers": [
      {
        "Id": "market",
        "Endpoint": "http://127.0.0.1:8004/mcp",
        "Enabled": true,
        "Required": true,
        "AllowedTools": [
          "list_available_indicators",
          "get_latest_price",
          "get_historical_prices",
          "calculate_indicators"
        ]
      },
      {
        "Id": "financial",
        "Endpoint": "http://localhost:8001/mcp",
        "Enabled": true,
        "Required": true,
        "AllowedTools": [
          "financial_get_current_facts",
          "financial_get_statement",
          "financial_compare_sources",
          "financial_list_metrics",
          "financial_get_ingestion_status"
        ]
      },
      {
        "Id": "news",
        "Endpoint": "http://localhost:8002/mcp",
        "Enabled": true,
        "Required": true,
        "AllowedTools": [
          "news_search",
          "news_get_company_news",
          "news_get_tone_summary",
          "news_get_timeline",
          "news_list_categories"
        ]
      },
      {
        "Id": "annual_reports",
        "Endpoint": "http://localhost:8003/mcp",
        "Enabled": true,
        "Required": false,
        "AllowedTools": [
          "reports_search_annual_report",
          "reports_get_report_section"
        ]
      },
      {
        "Id": "kite",
        "Endpoint": "https://mcp.kite.trade/mcp",
        "Enabled": true,
        "Required": false,
        "AllowedTools": [
          "login",
          "get_quotes",
          "get_ltp",
          "get_ohlc",
          "get_historical_data",
          "search_instruments",
          "get_profile",
          "get_margins",
          "get_holdings",
          "get_positions",
          "get_mf_holdings",
          "get_orders",
          "get_trades",
          "get_order_history",
          "get_order_trades",
          "get_gtts"
        ]
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Agent": {
    "Enabled": false,
    "Provider": "ollama",
    "Endpoint": "http://localhost:11434/",
    "Model": "",
    "ChatPath": "v1/chat/completions",
    "MaxCompletionTokens": 4096,
    "TimeoutSeconds": 180,
    "MaxToolRounds": 6,
    "MaxToolCalls": 20,
    "MaxToolResultCharacters": 30000,
    "MaxMessageCharacters": 12000,
    "AllowedMcpTools": [
      "market__list_available_indicators",
      "market__get_latest_price",
      "market__get_historical_prices",
      "market__calculate_indicators",
      "financial__financial_get_current_facts",
      "financial__financial_get_statement",
      "financial__financial_compare_sources",
      "financial__financial_list_metrics",
      "financial__financial_get_ingestion_status",
      "news__news_search",
      "news__news_get_company_news",
      "news__news_get_tone_summary",
      "news__news_get_timeline",
      "news__news_list_categories",
      "annual_reports__reports_search_annual_report",
      "annual_reports__reports_get_report_section",
      "kite__login",
      "kite__get_quotes",
      "kite__get_ltp",
      "kite__get_ohlc",
      "kite__get_historical_data",
      "kite__search_instruments",
      "kite__get_profile",
      "kite__get_margins",
      "kite__get_holdings",
      "kite__get_positions",
      "kite__get_mf_holdings",
      "kite__get_orders",
      "kite__get_trades",
      "kite__get_order_history",
      "kite__get_order_trades",
      "kite__get_gtts"
    ]
  }
}
